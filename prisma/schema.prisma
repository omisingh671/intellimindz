generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  LEARNER
}

enum LearnerType {
  STUDENT
  PROFESSIONAL
  REGULATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum DonationInterestStatus {
  NEW
  CONTACTED
  CLOSED
}

enum CoursePriceType {
  FREE
  PAID
  CONTACT
}

enum TaxMode {
  GST_EXCLUSIVE
  GST_INCLUSIVE
  GST_EXEMPT
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentPurpose {
  DONATION
  COURSE
}

enum PaymentMode {
  FULL
  EMI
  FLEXIBLE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id              String           @id @default(uuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  imageProvider   String?
  imageStorageKey String?
  passwordHash    String?
  mobile          String?
  city            String?
  learnerType     LearnerType?
  profileCompleted Boolean          @default(false)
  role            UserRole         @default(LEARNER)
  sessionVersion  Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  assignedLeads   Lead[]           @relation("AssignedLeads")
  payments        Payment[]

  @@index([role])
  @@index([learnerType])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  courseCount Int      @default(0)
  icon        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model CourseLevel {
  id        String   @id @default(uuid())
  label     String   @unique
  step      Int      @unique
  duration  String
  outcome   String
  idealFor  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model Course {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  categoryId  String
  levelId     String
  duration    String
  mode        String
  audience    String
  feeLabel    String
  tags        Json
  isLatest    Boolean     @default(false)
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    Category    @relation(fields: [categoryId], references: [id])
  level       CourseLevel @relation(fields: [levelId], references: [id])
  prices      CoursePrice[]
  coupons     CouponCourse[]
  payments    Payment[]

  @@index([categoryId])
  @@index([levelId])
  @@index([isPublished])
}

model CoursePrice {
  id              String          @id @default(uuid())
  courseId        String
  priceType       CoursePriceType @default(FREE)
  currency        String          @default("INR")
  baseAmountMinor Int?
  taxMode         TaxMode         @default(GST_EXCLUSIVE)
  gstRateBps      Int?
  isActive        Boolean         @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

model Coupon {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String
  description        String?            @db.Text
  discountType       CouponDiscountType
  discountValueBps   Int?
  discountAmountMinor Int?
  currency           String             @default("INR")
  minimumAmountMinor Int?
  maxRedemptions     Int?
  redeemedCount      Int                @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean            @default(true)
  appliesToAllCourses Boolean           @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  courses            CouponCourse[]
  payments           Payment[]

  @@index([isActive])
  @@index([validFrom, validUntil])
}

model CouponCourse {
  couponId  String
  courseId  String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@index([courseId])
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  email        String
  mobile       String?
  learnerType  LearnerType?
  courseId     String?
  message      String     @db.Text
  source       String     @default("website")
  status       LeadStatus @default(NEW)
  assignedToId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([learnerType])
  @@index([courseId])
}

model DonationInterest {
  id              String                 @id @default(uuid())
  amountMinor     Int
  currency        String                 @default("INR")
  firstName       String
  lastName        String
  email           String
  status          DonationInterestStatus @default(NEW)
  source          String                 @default("donation-form")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  payments        Payment[]

  @@index([email])
  @@index([status])
}

model Payment {
  id                 String          @id @default(uuid())
  purpose            PaymentPurpose
  mode               PaymentMode
  status             PaymentStatus   @default(PENDING)
  paymentGroupId     String
  installmentNo      Int?
  dueAt              DateTime?
  totalAmountMinor   Int
  amountMinor        Int
  currency           String          @default("INR")
  payerName          String
  payerEmail         String
  payerMobile        String?
  userId             String?
  courseId           String?
  donationInterestId String?
  couponId           String?
  metadata           Json?
  gateway            String?
  gatewayOrderId     String?
  gatewayPaymentId   String?
  gatewayStatus      String?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  course             Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  donationInterest   DonationInterest? @relation(fields: [donationInterestId], references: [id], onDelete: SetNull)
  coupon             Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([purpose])
  @@index([mode])
  @@index([status])
  @@index([paymentGroupId])
  @@index([payerEmail])
  @@index([userId])
  @@index([courseId])
  @@index([donationInterestId])
  @@index([couponId])
  @@index([createdAt])
}
